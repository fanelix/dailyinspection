{
  "name": "dailyinspection",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc -p apps-script",
    "sync:checklist": "node scripts/sync-checklist.mjs",
    "sync:location": "node scripts/sync-location.mjs",
    "check": "node scripts/sync-checklist.mjs --check && node scripts/sync-location.mjs --check && npm run typecheck && node --test checks/*.check.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "next": "16.3.8",
    "proj4": "2.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/google-apps-script": "2.0.13",
    "@types/leaflet": "1.9.21",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
