# Hanya nama variabel. Nilai asli diisi di Vercel (Environment Variables) atau .env.local; jangan di-commit.
GATEWAY_URL=            # URL web app Apps Script, berakhiran /exec
GATEWAY_HMAC_SECRET=    # sama persis dengan Script Property GATEWAY_HMAC_SECRET; acak, minimal 32 karakter
SESSION_SECRET=         # penanda tangan cookie sesi; BERBEDA dari GATEWAY_HMAC_SECRET; acak, minimal 32 karakter
# GATEWAY_TIMEOUT_MS=30000   # opsional; batas tunggu server ke gateway (usulan, belum diukur)
